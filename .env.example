# Copy to .env and provide the API key locally. Never commit .env.
GROQ_API_KEY=
GROQ_API_KEY_2=your_second_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20

# Predicted class 1 is assigned at or above this probability.
DRIFTING_ORACLE_CLASSIFICATION_THRESHOLD=0.15
DRIFTING_ORACLE_V2_CLASSIFICATION_THRESHOLD=0.22
DRIFTING_ORACLE_MAX_UPLOAD_BYTES=10485760
DRIFTING_ORACLE_MAX_BATCH_ROWS=5000
DRIFTING_ORACLE_MAX_UPLOAD_COLUMNS=500
DRIFTING_ORACLE_MAX_RBI_QUERY_CHARS=1000

# Local prediction monitoring. Keep the SQLite path on durable storage when deployed.
DRIFTING_ORACLE_MONITORING_DB_PATH=data/drift_monitoring.sqlite3
DRIFTING_ORACLE_WINDOW_DAYS=30
DRIFTING_ORACLE_MIN_SAMPLE_SIZE=100
DRIFTING_ORACLE_MAX_MONITORING_ROWS=10000
DRIFTING_ORACLE_RETENTION_DAYS=180
DRIFTING_ORACLE_PSI_MODERATE_THRESHOLD=0.10
DRIFTING_ORACLE_PSI_CRITICAL_THRESHOLD=0.20
DRIFTING_ORACLE_MISSING_MODERATE_DELTA=0.05
DRIFTING_ORACLE_MISSING_CRITICAL_DELTA=0.10

GEMINI_API_KEY=your_dummy_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Admin access: JSON mapping usernames to bcrypt hashes; never use plaintext passwords.
# Generate a hash and signing secret as documented in README.md.
# Example format: {"<username>":"<bcrypt-hash>"}
DRIFTING_ORACLE_ADMIN_CREDENTIALS_JSON=
DRIFTING_ORACLE_ADMIN_TOKEN_SECRET=
DRIFTING_ORACLE_ADMIN_TOKEN_TTL_SECONDS=28800