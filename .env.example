# Copy to .env and provide the API key locally. Never commit .env.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20

# Predicted class 1 is assigned at or above this probability.
DRIFTING_ORACLE_CLASSIFICATION_THRESHOLD=0.15
DRIFTING_ORACLE_MAX_UPLOAD_BYTES=10485760
DRIFTING_ORACLE_MAX_BATCH_ROWS=5000
